thesis/figures/

# Raw and derived datasets
*.pkl
dataset_*/
dataset-smi-frag*/
*_emolfrag_output/

# Model checkpoints and predictions
*.pt
*_predictions.csv
*_embeddings.pkl

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# Logs and scratch
*.log
nohup.out
.DS_Store

